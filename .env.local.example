# Google Gemini API key for the agent + image generation.
# Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: where to persist plant + chat data (defaults to ~/.roots/)
# ROOTS_DATA_DIR=

# Optional: model to use. Default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Optional: image model for sprite gen. Default: gemini-2.5-flash-image-preview
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview
